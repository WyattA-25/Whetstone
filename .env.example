# Copy to .env and fill in. Never commit .env.

# --- Luminal Cloud (optimizer agents; OpenAI-compatible) ---
LUMINAL_API_KEY=
LUMINAL_BASE_URL=
LUMINAL_MODEL=
# USD per 1M tokens: placeholder estimates, update with Luminal's real price
LUMINAL_PRICE_IN_PER_M=0.10
LUMINAL_PRICE_OUT_PER_M=0.40

# --- "Customer" scoring key (for the demo, our own test key stands in) ---
SCORING_API_KEY=
SCORING_BASE_URL=
SCORING_MODEL=

# --- Storage: local | dynamo (dynamo = local files + AWS DynamoDB) ---
WHETSTONE_STORE=dynamo
DYNAMO_RUNS_TABLE=whetstone-runs
DYNAMO_ACCOUNTS_TABLE=whetstone-accounts

# --- Encryption of stored customer API keys (32-byte base64 secret box key) ---
KEY_ENCRYPTION_MASTER_KEY=

# --- AWS ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=

# --- Payments (AWS beta tool, Stripe as fallback; test mode only) ---
AWS_PAYMENTS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Budgets ---
OPTIMIZER_MAX_USD_PER_RUN=2.00
LLM_MAX_CONCURRENCY=8

# --- Web UI: account features (API keys, starting runs). Keep off on public deployments ---
WHETSTONE_ACCOUNT_API=off
KMS_KEY_ALIAS=alias/whetstone-customer-keys

# --- Cognito (customer sign-in; created by python -m whetstone.aws_setup) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Gate run starts on an AWS App Monetization entitlement (fail-closed). 'off' = check + log only.
WHETSTONE_BILLING_ENFORCE=on

# Return URL for hosted checkout/portal. "localhost" works; the literal 127.0.0.1 is rejected by the billing firewall.
WHETSTONE_PUBLIC_URL=http://localhost:8000/
